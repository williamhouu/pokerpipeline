# Virtual environment
venv/
.venv/

# Solver outputs — large binary files (GBs each), kept local, never committed
test_solves/
solves/
*.cfr
*.solve
*.monker

# Preflop range packs — extracted locally (~20k files, ~94MB), not committed.
# Layout + scenario→file mappings are documented in docs/ryan_range_pack_index.md.
ranges/

# PLO preflop chart pack — same deal as ranges/ (large, local-only). Lands
# here once purchased; the pipeline.plo parser reads it.
plo_ranges/

# NLHE 9-max Monker pack (June 2026) — MonkerViewer export, 93k .rng files
# (~428MB extracted), local-only like the other packs. The canonical full
# solve (the 3.4GB .mkr) stays in the team Dropbox.
nlhe9_ranges/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*

# Prompt-editor overrides -- written by the admin panel's Prompt page when
# you save an edited prompt. These are local experiments by design; commit
# changes via VOICE_RULES_PREFLOP / PREFLOP_ARCHETYPE_GUIDANCE in the
# pipeline source when you want them part of the team default.
admin_panel/prompts/

# Editors
.idea/
.vscode/

# Claude Code personal/local settings (shared settings.json stays tracked)
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Working extraction scratch files
docs/_*.txt

# Generated pipeline output (demo CSVs etc.) -- the directory's own
# .gitignore narrows this to "ignore contents, keep the dir," so scripts have
# somewhere to write and we still version the ignore rule itself.
test_output/*
!test_output/.gitignore
# Whitelist exception: the consolidated Tier-1 dataset IS a shipped artifact
# (handoff deliverable for downstream consumers), so it stays tracked while
# the per-batch verification CSVs (v7, v7_1, v7_3, ...) stay local.
!test_output/tier1_consolidated.csv
